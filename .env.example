# PlaceGuard Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================
# Dev default (SQLite — no setup required):
DATABASE_URL=sqlite:///./placeguard_dev.db
# Production (PostgreSQL — uncomment and fill in):
# DATABASE_URL=postgresql://placeguard:placeguard@localhost:5432/placeguard
DATABASE_ECHO=false

# ============================================================================
# LLM PROVIDER
# ============================================================================
# Options: ollama | gemini | openai | claude
LLM_PROVIDER=gemini

# Ollama Configuration (Local, Free, No Rate Limits!)
# Install from: https://ollama.ai
# Then run: ollama pull llama3.1:8b
# Uncomment if using Ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TEMPERATURE=0.1

# Gemini Configuration (Google AI) - RECOMMENDED
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=30

# OpenAI Configuration (for future use)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.1

# Claude Configuration (for future use)
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-3-haiku-20240307
# CLAUDE_TEMPERATURE=0.1

# ============================================================================
# API / SECURITY
# ============================================================================
JWT_SECRET=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=[\"http://localhost:3000\", \"http://localhost:3001\"]

# ============================================================================
# APPLICATION
# ============================================================================
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# GMAIL API INTEGRATION
# ============================================================================
# Gmail API credentials (OAuth 2.0)
# See docs/GMAIL_SETUP.md for setup instructions
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Placement officer email address (only process emails from this sender)
# IMPORTANT: Set this to your actual placement officer's email
# Example: PLACEMENT_OFFICER_EMAIL=tpo@college.edu
PLACEMENT_OFFICER_EMAIL=placement@college.edu

# Gmail polling configuration
# Enable automatic background polling (true/false)
GMAIL_POLLING_ENABLED=true

# Polling interval in minutes (default: 60 = every hour)
# Lower values = more frequent checks but more API quota usage
# Recommended: 60-120 minutes
GMAIL_POLLING_INTERVAL_MINUTES=60

# Gmail label for processed emails
# This label is automatically created and applied to processed emails
# Use format: "Parent/Child" for nested labels
GMAIL_PROCESSED_LABEL=PlaceGuard/Processed
