# =============================================================================
# PlaceGuard — .gitignore
# =============================================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
virtualenv/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.hypothesis/
.tox/
nosetests.xml
test-results/

# ---------------- Environment / Secrets ----------------
.env
.env.*
!.env.example
!.env.local.example

# Gmail API credentials and tokens (NEVER commit these!)
credentials.json
token.json
gmail_credentials.json
gmail_token.json

# ---------------- Database ----------------
*.db
*.sqlite
*.sqlite3
placeguard_dev.db

# ---------------- Vector store (regenerated by reindex_all_facts) ----------------
data/chroma_db/

# ---------------- Mock WhatsApp console image uploads ----------------
data/mock_whatsapp_uploads/

# ---------------- Alembic ----------------
# Keep migrations tracked; ignore only generated temp files
alembic/versions/__pycache__/

# ---------------- IDE / Editor / AI tooling ----------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
.kiro/

# ---------------- OS ----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------- Frontend — Node / Next.js ----------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.eslintcache
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Frontend env files (keep examples)
frontend/.env
frontend/.env.*
!frontend/.env.local.example

# ---------------- Logs ----------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------- Misc project artifacts ----------------
verify_task1.py

# ---------------- Documentation (not tracked) ----------------
DESIGN.md
IMPLEMENTATION.md
EVAL_IMPLEMENTATION_HANDOFF.md
BRANCH_EXTRACTION_FIX_PLAN.md
